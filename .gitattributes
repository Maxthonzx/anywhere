# 统一换行符：仓库内一律 LF，避免 Mac/Win 之间整文件 diff
* text=auto eol=lf

# Windows 专用脚本保持 CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# shell 脚本必须是 LF，否则 Git Bash 下会报错
*.sh  text eol=lf

# 二进制文件
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
